## New file: pyproject.toml
[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "asseto-asset-management"
version = "0.1.0"
description = "Django-based asset management SaaS platform"
requires-python = ">=3.11"

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "AssetManagement.settings"
python_files = ["tests.py", "test_*.py", "*_tests.py"]
addopts = "-m 'not selenium' --cov=. --cov-report=term-missing --cov-report=html"
markers = [
    "selenium: marks tests as selenium-based (deselect with '-m \"not selenium\"')",
    "slow: marks tests as slow",
    "integration: marks tests as integration tests",
]
testpaths = [".", "tests"]
norecursedirs = [".git", ".venv", "venv", "env", "node_modules", ".superpowers"]

[tool.black]
line-length = 88
target-version = ["py311", "py312", "py313"]
include = '\.pyi?$'
extend-exclude = '''
/(
  # directories
  \.eggs
  | \.git
  | \.hg
  | \.mypy_cache
  | \.tox
  | \.venv
  | build
  | dist
  | migrations
  | node_modules
  | venv
)/
'''

[tool.ruff]
line-length = 88
target-version = "py311"
exclude = [
    ".git",
    ".venv",
    "venv",
    "env",
    ".tox",
    "migrations",
    "node_modules",
    ".superpowers",
    "__pycache__",
    ".eggs",
    "build",
    "dist",
]
select = [
    "E",     # pycodestyle errors
    "W",     # pycodestyle warnings
    "F",     # Pyflakes
    "I",     # isort
    "C4",    # flake8-comprehensions
    "B",     # flake8-bugbear
    "UP",    # pyupgrade
]
ignore = [
    "E501",  # line too long (handled by black)
    "B008",  # do not perform function calls in argument defaults
]

[tool.ruff.isort]
known-first-party = ["AssetManagement"]
known-django = ["django"]
sections = ["FUTURE", "STDLIB", "DJANGO", "THIRDPARTY", "FIRSTPARTY", "LOCALFOLDER"]

[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
check_untyped_defs = false
disallow_untyped_defs = false
plugins = ["mypy_django_plugin.main"]

[[tool.mypy.overrides]]
module = [
    "django.*",
    "rest_framework.*",
    "celery.*",
    "drf_spectacular.*",
    "django_silk.*",
    "django_htmx.*",
]
ignore_missing_imports = true

[tool.django-stubs]
django_settings_module = "AssetManagement.settings"

## New file: .pre-commit-config.yaml
repos:
  # Standard pre-commit-hooks
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.2.0
    hooks:
      - id: trailing-whitespace
        name: Trim trailing whitespace
      - id: end-of-file-fixer
        name: Fix end of file
      - id: check-yaml
        name: Check YAML
        args: ["--unsafe"]
      - id: check-merge-conflict
        name: Check merge conflict
      - id: check-added-large-files
        name: Check for large files
        args: ["--maxkb=500"]
      - id: no-commit-to-branch
        name: Prevent commits to main/master
        args: ["--branch=main", "--branch=master"]

  # Ruff (linting and import sorting)
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.6.9
    hooks:
      - id: ruff
        name: Ruff lint
        args: ["--fix"]
      - id: ruff-format
        name: Ruff format

  # Black (code formatting)
  - repo: https://github.com/psf/black
    rev: 26.3.1
    hooks:
      - id: black
        name: Black format
        language_version: python3.11

  # MyPy (static type checking)
  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v1.14.1
    hooks:
      - id: mypy
        name: MyPy type check
        additional_dependencies:
          - "django-stubs"
          - "types-redis"
          - "types-requests"
          - "djangorestframework-stubs"
        args: ["--ignore-missing-imports"]
        exclude: "^(migrations/|tests/)"

  # Local hooks for code quality enforcement
  - repo: local
    hooks:
      # No debug code (print, pdb, breakpoint, ipdb)
      - id: no-debug-code
        name: No debug code
        description: Check for debug statements (print, pdb, breakpoint, ipdb)
        entry: bash -c 'grep -r --include="*.py" --exclude-dir=venv --exclude-dir=.venv -E "^\s*(print\(|pdb\.set_trace\(\)|breakpoint\(\)|ipdb\.)" . && exit 1 || exit 0'
        language: system
        stages: [commit]

      # No commented-out code
      - id: no-commented-code
        name: No commented code
        description: Check for commented-out code (def, class, return, import, etc.)
        entry: bash -c 'grep -r --include="*.py" --exclude-dir=venv --exclude-dir=.venv -E "^\s*#\s*(def |class |return |import |from |if |for |while |async )" . && exit 1 || exit 0'
        language: system
        stages: [commit]

      # No backup files
      - id: no-backup-files
        name: No backup files
        description: Check for backup files (_old, _backup, _bak, etc.)
        entry: bash -c 'find . -type f \( -name "*_old.*" -o -name "*_backup.*" -o -name "*_bak.*" -o -name "*_copy.*" -o -name "*_orig.*" -o -name "*_temp.*" -o -name "*_tmp.*" -o -name "*_final.*" \) \( -name "*.py" -o -name "*.html" -o -name "*.js" -o -name "*.css" -o -name "*.md" \) | grep -v ".venv" | grep -v "venv" && exit 1 || exit 0'
        language: system
        stages: [commit]

default_language_version:
  python: python3.11

ci:
  autofix_commit_msg: "chore: auto-fix pre-commit hooks"
  autofix_prs: true
  autoupdate_commit_msg: "chore: pre-commit hooks auto-update"
  autoupdate_branch: ""
  skip: []
  submodules: false
